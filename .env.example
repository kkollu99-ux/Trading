PORT=4173
JWT_SECRET=change-this-before-production

# Optional PostgreSQL connection. Railway Postgres provides this automatically when linked.
DATABASE_URL=

# Charts are generated locally; only latest real prices are fetched.
# Crypto (Coinbase) and forex (ECB/Frankfurter) need no key.
# Stocks: Finnhub API key.
FINNHUB_API_KEY=
# Gold, silver, oil: Twelve Data API key.
MARKET_DATA_API_KEY=

# Email (sign-up verification codes and password resets). On a deployed server
# one of these is REQUIRED - without it those forms refuse rather than reveal
# a code. Resend is recommended (Railway blocks outbound SMTP on small plans):
# verify your domain at resend.com, then set both.
RESEND_API_KEY=
EMAIL_FROM=FXCC Capitals <no-reply@yourdomain.com>
# ...or SMTP, if your host allows it:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Comma-separated symbols users are allowed to see/trade.
ALLOWED_SYMBOLS=XAU/USD,XAG/USD,BTC/USD,EUR/USD,GBP/USD,USOIL
