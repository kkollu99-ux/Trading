PORT=4173
JWT_SECRET=change-this-before-production

# Optional PostgreSQL connection. Railway Postgres provides this automatically when linked.
DATABASE_URL=

# No external market-data provider needed - every price (quotes, candle
# history, FX conversion) is generated locally. See quoteLiveSymbols in
# server.js for which symbols get an actively "ticking" live price.

# Comma-separated symbols users are allowed to see/trade.
ALLOWED_SYMBOLS=XAU/USD,XAG/USD,BTC/USD,EUR/USD,GBP/USD,USOIL
