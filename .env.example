PORT=4173
JWT_SECRET=change-this-before-production

# First admin account, created only on an empty database. Without ADMIN_PASSWORD a deployed server
# makes a random password and prints it once in its logs.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional PostgreSQL connection. On Render use the database's Internal Database URL.
DATABASE_URL=
# DATABASE_SSL=false   # only for a Postgres that doesn't offer TLS (local / private network)

# Folder for uploaded KYC documents and chat images. On Render, point this at a persistent disk
# (e.g. /var/data/uploads) or the files are lost on every deploy.
# UPLOAD_DIR=

# Charts are generated locally; only latest real prices are fetched.
# Crypto (Coinbase) and forex (ECB/Frankfurter) need no key.
# Stocks: Finnhub API key.
FINNHUB_API_KEY=
# Gold, silver, oil: Twelve Data API key.
MARKET_DATA_API_KEY=

# Email (sign-up verification codes and password resets). On a deployed server
# one of these is REQUIRED - without it those forms refuse rather than reveal
# a code. Resend is recommended (Render and Railway block outbound SMTP on small plans):
# verify your domain at resend.com, then set both.
RESEND_API_KEY=
EMAIL_FROM=FXCM Capitals <no-reply@yourdomain.com>
# ...or SMTP, if your host allows it:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Comma-separated symbols users are allowed to see/trade.
ALLOWED_SYMBOLS=XAU/USD,XAG/USD,BTC/USD,EUR/USD,GBP/USD,USOIL
